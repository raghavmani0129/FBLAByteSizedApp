<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="12"
      alignment="CENTER"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.SignupController"
      styleClass="card">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Create Account" styleClass="h1" />

    <TextField fx:id="nameField"
               promptText="Full Name"
               maxWidth="260"/>

    <TextField fx:id="emailField"
               promptText="Email"
               maxWidth="260"/>

    <PasswordField fx:id="passwordField"
                   promptText="Password"
                   maxWidth="260"/>

    <Label text="Password must be 8+ characters with uppercase and number"
           styleClass="subtle"
           wrapText="true"
           maxWidth="260"/>

    <Label fx:id="captchaLabel"
           text="CAPTCHA"
           styleClass="h2" />

    <TextField fx:id="captchaField"
               promptText="Solve CAPTCHA"
               maxWidth="260"/>

    <Button text="Create Account"
            onAction="#handleCreateAccount"
            maxWidth="260"
            styleClass="primary"/>

    <Button text="Back to Login"
            onAction="#handleBackToLogin"
            maxWidth="260"
            styleClass="secondary"/>

    <Label fx:id="errorLabel"
           textFill="red"
           wrapText="true"
           maxWidth="260"/>

</VBox>
